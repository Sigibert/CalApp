<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Change this one value when preparing the next release. -->
    <WeekTrayInfoVersion>2.0.1</WeekTrayInfoVersion>
    <WeekTrayInfoNumericVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(WeekTrayInfoVersion)', '[-+].*$', '')).0</WeekTrayInfoNumericVersion>
  </PropertyGroup>
</Project>
